# dragongl-client — launcher for the Dragon GL 3D client (Vulkan).

set -euo pipefail

# --print-config writes a settings file to standard output: no banner in it.
BANNER=1
for arg in "$@"; do
    [[ $arg == --print-config ]] && BANNER=0
done
((BANNER)) && cat <<"EOF"
###############################################################################
#                                                                             #
#                      Dragon GL - Arcane Game Engine                         #
#                              CLIENT MODULE                                  #
#                                                                             #
###############################################################################
EOF

show_help() {
    cat <<EOF

Usage: ${0##*/} [options] [server_host [port]]

  server_host   host name, IPv4 or IPv6 address of the game server
                (asked interactively when omitted; default 127.0.0.1)
  port          TCP port of the game server (default 8080)
  --fingerprint SHA-256 fingerprint of the server certificate, as the
                server owner gives it: trust that certificate only
  --ui-scale N  size of the HUD, 0.5 to 4 (default: from the monitor and
                the window; Ctrl+= and Ctrl+- change it while playing)
  --print-config
                write the settings file with every default and key to
                standard output, and exit
  --frames N    draw N frames, print the frame times and exit
  -h, --help    show this help

Commands are typed in the window (Enter) or in this terminal; F1 lists
the keys. Settings and keys: ~/.config/dragongl/client.conf, for example
  ${0##*/} --print-config > ~/.config/dragongl/client.conf

The connection is TLS 1.3. A self-signed server is recorded at the first
connection in ~/.config/dragongl/known_servers; a different certificate
is refused later.

The client renders with Vulkan 1.3 (GPU-driven: culling and mesh
generation run in compute shaders). Environment:
  DRAGONGL_WINDOW=WxH       initial window size (default: 80% of the screen)
  DRAGONGL_GPU=<index|name> pick the GPU (the list is printed at start-up)
  DRAGONGL_VSYNC=0          present without waiting for vertical sync
  VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation   Vulkan validation

Examples:
  ${0##*/}
  ${0##*/} 192.168.1.10 9000
  ${0##*/} 2001:db8::10
  ${0##*/} --fingerprint SHA256:0E:0D:...:C9 game.example.org
EOF
}

die() { printf '\n[ERROR] %s\n' "$*" >&2; exit 1; }

ARGS=()
OPTS=()
while (($#)); do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --fingerprint|--ui-scale|--frames)
            (($# >= 2)) || die "$1 needs a value"
            OPTS+=("$1" "$2")
            shift 2
            ;;
        --print-config)
            OPTS+=("$1")
            shift
            ;;
        gl|vk)
            die "'$1' is no longer needed: the client has a single Vulkan renderer. Usage: ${0##*/} [server_host [port]]"
            ;;
        -*)
            show_help >&2
            die "unknown option: $1"
            ;;
        *)
            ((${#ARGS[@]} < 2)) || { show_help >&2; die "too many arguments"; }
            ARGS+=("$1")
            shift
            ;;
    esac
done

# --- Client binary: next to this script (RPM: /usr/bin) or in build/ ------
# The shaders are found next to the binary (build/shaders) or in
# /usr/share/dragongl/shaders: the working directory does not matter.
HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -x $HERE/dragongl_client ]]; then
    BIN="$HERE/dragongl_client"
elif [[ -x $HERE/build/dragongl_client ]]; then
    BIN="$HERE/build/dragongl_client"
else
    die "dragongl_client not found next to ${0##*/} or in build/. Build it with: ./build.sh -n"
fi

exec "$BIN" "${OPTS[@]}" "${ARGS[@]}"
