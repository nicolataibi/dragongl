# dragongl-server — launcher for the Dragon GL game server.
#
# Passwords never go on the command line (every local user can read it
# with ps). They come from files, from the environment, or are asked
# interactively, and reach the server through its environment, which the
# server wipes at start-up.

set -euo pipefail

cat <<"EOF"
###############################################################################
#                                                                             #
#                      Dragon GL - Arcane Game Engine                         #
#                              SERVER MODULE                                  #
#                                                                             #
###############################################################################
EOF

show_help() {
    cat <<EOF

Usage: ${0##*/} [options]

Options:
  --password-file <file>     server access password (first line of the file)
  --dm-password-file <file>  Dungeon Master password (optional)
  -P, --port <port>          TCP port (default: 8080)
  -D, --data-dir <dir>       read-only game data (default: ./data, else /usr/share/dragongl/data)
  -S, --state-dir <dir>      world, saves and logs (default: state/ in a development
                             tree, otherwise $XDG_STATE_HOME/dragongl or
                             ~/.local/state/dragongl)
  -h, --help                 show this help

Without --password-file the launcher uses DRAGONGL_SERVER_PASSWORD, or asks
for the password when run from a terminal. The DM account is enabled only
when a DM password is given (--dm-password-file, DRAGONGL_DM_PASSWORD or the
interactive prompt). Passwords: 8-31 printable ASCII characters, no spaces.

Examples:
  ${0##*/}
  ${0##*/} --password-file ~/.config/dragongl/server.pw --port 9000
  DIAGNOSTICS=0 ${0##*/} --password-file server.pw --dm-password-file dm.pw
EOF
}

die() { printf '\n[ERROR] %s\n' "$*" >&2; exit 1; }

ARGS=()
HAVE_GATE_FILE=0
HAVE_DM_FILE=0
HAVE_STATE_DIR=0
while (($#)); do
    case $1 in
        --password-file|--dm-password-file|-P|--port|-D|--data-dir|-S|--state-dir)
            (($# > 1)) || die "$1 needs a value"
            [[ $1 == --password-file ]] && HAVE_GATE_FILE=1
            [[ $1 == --dm-password-file ]] && HAVE_DM_FILE=1
            [[ $1 == -S || $1 == --state-dir ]] && HAVE_STATE_DIR=1
            ARGS+=("$1" "$2")
            shift 2
            ;;
        -p|--password|-d|--dm-password)
            die "$1 is no longer supported: passwords on the command line are visible to every user. Use --password-file / --dm-password-file, or let the launcher ask."
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            show_help >&2
            die "unknown option: $1"
            ;;
    esac
done

# --- Server binary: next to this script (RPM: /usr/bin) or in build/ ------
HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -x $HERE/dragongl_server ]]; then
    BIN="$HERE/dragongl_server"
elif [[ -x $HERE/build/dragongl_server ]]; then
    BIN="$HERE/build/dragongl_server"
    # Development tree: data/ is relative to the project root, and the
    # state (world, saves, logs) stays in the git-ignored state/ next to it.
    cd -- "$HERE"
    if ((!HAVE_STATE_DIR)) && [[ -z ${DRAGONGL_STATE_DIR:-} ]]; then
        ARGS+=(--state-dir "$HERE/state")
    fi
else
    die "dragongl_server not found next to ${0##*/} or in build/. Build it with: ./build.sh -n"
fi

# --- Passwords ------------------------------------------------------------------
ask_secret() { # ask_secret <prompt> <variable>
    local value
    IFS= read -rs -p "$1" value
    printf '\n'
    printf -v "$2" '%s' "$value"
}

if ((!HAVE_GATE_FILE)) && [[ -z ${DRAGONGL_SERVER_PASSWORD:-} ]]; then
    [[ -t 0 ]] || die "no server password: use --password-file or DRAGONGL_SERVER_PASSWORD."
    ask_secret "Server access password: " DRAGONGL_SERVER_PASSWORD
    if ((!HAVE_DM_FILE)) && [[ -z ${DRAGONGL_DM_PASSWORD:-} ]]; then
        ask_secret "Dungeon Master password (empty = DM account disabled): " DRAGONGL_DM_PASSWORD
    fi
fi
export DRAGONGL_SERVER_PASSWORD="${DRAGONGL_SERVER_PASSWORD:-}"
export DRAGONGL_DM_PASSWORD="${DRAGONGL_DM_PASSWORD:-}"
[[ -n $DRAGONGL_SERVER_PASSWORD ]] || unset DRAGONGL_SERVER_PASSWORD
[[ -n $DRAGONGL_DM_PASSWORD ]] || unset DRAGONGL_DM_PASSWORD

# --- Host diagnostics -------------------------------------------------------------
# NOTE (privacy): prints host IPs, uptime, memory and disk usage. If the
# server log is shared, run with DIAGNOSTICS=0.
if [[ ${DIAGNOSTICS:-1} != 0 ]]; then
    printf '\n========================================\n'
    printf '[SYSTEM] Diagnostic Data for the Master\n'
    printf '========================================\n'
    printf '\n[OS]\n'; uname -a
    printf '\n[UPTIME & LOAD]\n'; uptime || true
    printf '\n[MEMORY]\n'; free -m || true
    printf '\n[DISK SPACE]\n'; df -h . || true
    printf '\n[NETWORK (IP Addresses)]\n'
    ip -brief address show 2>/dev/null || hostname -I 2>/dev/null || true
    printf '\n========================================\n\n'
fi

exec "$BIN" "${ARGS[@]}"
