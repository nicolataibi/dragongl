{
  "$comment": "The Dragon GL wire protocol, one table for everything: tools/gen_protocol.py generates the C structs and codec (include/wire_gen.h, src/shared/wire_gen.c), the C conformance test (tests/test_protocol_conformance.c), the test vectors (tests/protocol_vectors.json) and the message sections of PROTOCOL.md; tests/integration/dglproto.py reads it at run time. Edit this file, then run tools/gen_protocol.py.",
  "version": 5,
  "constants": {
    "PROTO_NAME_LEN": {
      "value": 32,
      "doc": "username, equipment and item names (field size, NUL included)"
    },
    "PROTO_SECRET_LEN": {
      "value": 64,
      "doc": "personal and server passwords"
    },
    "PROTO_TEXT_LEN": {
      "value": 256,
      "doc": "MSG_TEXT and MSG_TEXT_CMD"
    },
    "PROTO_REASON_LEN": {
      "value": 128,
      "doc": "MSG_AUTH_FAIL"
    },
    "WIRE_MAX_CHUNK_SIDE": {
      "value": 256,
      "doc": "largest side of a MSG_MAP_CHUNK rectangle"
    },
    "WIRE_MAX_ENTITY_RECS": {
      "value": 4096,
      "doc": "most records in one MSG_ENTITY_UPDATE"
    }
  },
  "external": {
    "MAP_WIDTH": {
      "value": 300,
      "header": "map.h"
    },
    "MAP_HEIGHT": {
      "value": 300,
      "header": "map.h"
    },
    "VOXEL_COUNT": {
      "value": 28,
      "header": "map.h"
    },
    "COMBAT_EV_MAX": {
      "value": 8,
      "header": "protocol.h"
    }
  },
  "records": {
    "EntityUpdateRec": {
      "doc": "Position and HP of one entity.",
      "fields": [
        {
          "name": "entity_id",
          "type": "i32"
        },
        {
          "name": "x",
          "type": "i16"
        },
        {
          "name": "y",
          "type": "i16"
        },
        {
          "name": "hp",
          "type": "i32"
        }
      ]
    }
  },
  "messages": [
    {
      "id": 1,
      "name": "LOGIN",
      "struct": "MsgLogin",
      "dir": "C2S",
      "doc": "Authentication, and the creation choices of a new character",
      "notes": "The creation fields are used only when the character does not exist yet; the ability scores of a new character are rolled by the server.",
      "fields": [
        {
          "name": "username",
          "type": "str",
          "cap": "PROTO_NAME_LEN",
          "doc": "`[A-Za-z0-9_]{1,16}`, or `dm` for the Dungeon Master"
        },
        {
          "name": "password",
          "type": "str",
          "cap": "PROTO_SECRET_LEN",
          "doc": "Personal password (1-63 printable characters), verified with Argon2id"
        },
        {
          "name": "server_pass",
          "type": "str",
          "cap": "PROTO_SECRET_LEN",
          "doc": "Server access password (8-63 characters)"
        },
        {
          "name": "race_id",
          "type": "i8",
          "doc": "RaceType"
        },
        {
          "name": "subrace_id",
          "type": "i8",
          "doc": "SubraceType, -1 = none"
        },
        {
          "name": "class_id",
          "type": "i8",
          "doc": "ClassType"
        },
        {
          "name": "alignment",
          "type": "i8",
          "doc": "Alignment"
        }
      ],
      "examples": [
        {
          "username": "alice",
          "password": "secret",
          "server_pass": "gate-pass",
          "race_id": 2,
          "subrace_id": -1,
          "class_id": 11,
          "alignment": 4
        }
      ]
    },
