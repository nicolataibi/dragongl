    {
      "id": 5,
      "name": "MAP_CHUNK",
      "struct": "MsgMapChunk",
      "dir": "S2C",
      "doc": "A rectangle of floor tiles",
      "notes": "The tiles follow row by row; they stay in the payload buffer (`tiles` points into it after decoding).",
      "fields": [
        {
          "name": "start_x",
          "type": "i16",
          "min": 0
        },
        {
          "name": "start_y",
          "type": "i16",
          "min": 0
        },
        {
          "name": "width",
          "type": "i16",
          "min": 1,
          "max": "WIRE_MAX_CHUNK_SIDE"
        },
        {
          "name": "height",
          "type": "i16",
          "min": 1,
          "max": "WIRE_MAX_CHUNK_SIDE"
        },
        {
          "name": "tiles",
          "type": "bytes",
          "length": "width * height",
          "max": "VOXEL_COUNT - 1",
          "doc": "`VoxelType` of every tile"
        }
      ],
      "checks": [
        {
          "expr": "start_x + width <= MAP_WIDTH",
          "doc": "the rectangle lies inside the map"
        },
        {
          "expr": "start_y + height <= MAP_HEIGHT",
          "doc": "the rectangle lies inside the map"
        }
      ],
      "examples": [
        {
          "start_x": 10,
          "start_y": 20,
          "width": 3,
          "height": 2,
          "tiles": [
            0,
            1,
            2,
            3,
            27,
            5
          ]
        }
      ]
    },
    {
