    {
      "id": 12,
      "name": "ENTITY_UPDATE",
      "struct": "MsgEntityUpdate",
      "dir": "S2C",
      "doc": "Position and HP of entities already known to the client",
      "notes": "Only entities the client already received a `MSG_STATE` for; unknown ids are ignored.",
      "fields": [
        {
          "name": "recs",
          "type": "records",
          "record": "EntityUpdateRec",
          "count_type": "u16",
          "min": 1,
          "max": "WIRE_MAX_ENTITY_RECS",
          "count_name": "count"
        }
      ],
      "examples": [
        {
          "recs": [
            {
              "entity_id": 1,
              "x": 2,
              "y": 3,
              "hp": 4
            },
            {
              "entity_id": -5,
              "x": 299,
              "y": 0,
              "hp": -1
            }
          ]
        }
      ]
    },
    {
      "id": 13,
      "name": "COMBAT_EVENT",
      "struct": "MsgCombatEvent",
      "dir": "S2C",
      "doc": "What the floating combat text shows",
      "notes": "`kind`: 1 the player took damage (amount = HP lost), 2 the player hit a monster (`entity_id`, damage), 3 critical hit on a monster, 4 a monster missed the player, 5 the player missed, 6 the player recovered HP, 7 the player picked up gold, 8 level up (amount = new level). The client draws floating combat text from these events, never from the wording of `MSG_TEXT` lines.",
      "fields": [
        {
          "name": "kind",
          "type": "u8",
          "min": 1,
          "max": "COMBAT_EV_MAX",
          "doc": "CombatEventKind"
        },
        {
          "name": "entity_id",
          "type": "i32"
        },
        {
          "name": "amount",
          "type": "i32"
        }
      ],
      "examples": [
        {
          "kind": 2,
          "entity_id": 4242,
          "amount": 17
        }
      ]
    }
  ]
