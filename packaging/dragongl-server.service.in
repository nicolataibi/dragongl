# Dragon GL game server, as a system service.
#
#   1. Set the passwords in @DRAGONGL_SYSCONFDIR@/dragongl/dragongl-server.conf
#   2. systemctl enable --now dragongl-server
#
# The server runs as a transient unprivileged user (DynamicUser) and keeps
# its world, characters and logs in /var/lib/dragongl (StateDirectory).
# To start a new world: systemctl stop dragongl-server, then
# dragongl-reset-world -S /var/lib/dragongl.

[Unit]
Description=Dragon GL game server
Documentation=man:dragongl_server(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Passwords and extra options (root-only file). Its values reach the server
# through the environment, which the server wipes at start-up.
EnvironmentFile=@DRAGONGL_SYSCONFDIR@/dragongl/dragongl-server.conf
ExecStart=@DRAGONGL_BINDIR@/dragongl_server --state-dir ${STATE_DIRECTORY} --data-dir @DRAGONGL_PKGDATADIR@/data $DRAGONGL_SERVER_ARGS
DynamicUser=yes
StateDirectory=dragongl
StateDirectoryMode=0700
UMask=0077
# SIGTERM saves every character and the world: give it time.
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
# Exit status 2 is a configuration error (missing or weak password, bad
# option): restarting would not help.
RestartPreventExitStatus=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
