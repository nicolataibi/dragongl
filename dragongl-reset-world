#
# dragongl-reset-world — delete the server state (world, NPCs, artifacts,
# characters, tombstones, logs, DM maps) so the next start generates a
# new world.
#
# The state directory is resolved exactly like the server does:
# --state-dir, $DRAGONGL_STATE_DIR, state/ in a development tree,
# $XDG_STATE_HOME/dragongl, ~/.local/state/dragongl.

set -euo pipefail

show_help() {
    cat <<EOF
Usage: ${0##*/} [options]

Options:
  -S, --state-dir <dir>  state directory to reset (see below)
  -y, --yes              do not ask for confirmation
  -h, --help             show this help

Without --state-dir: \$DRAGONGL_STATE_DIR, else state/ when run from a
development tree, else \$XDG_STATE_HOME/dragongl, else ~/.local/state/dragongl.
Stop the server first.
EOF
}

die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

STATE_DIR=""
ASSUME_YES=0
while (($#)); do
    case $1 in
        -S|--state-dir) (($# > 1)) || die "$1 needs a value"; STATE_DIR=$2; shift 2 ;;
        -y|--yes) ASSUME_YES=1; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) show_help >&2; die "unknown option: $1" ;;
    esac
done

if [[ -z $STATE_DIR ]]; then
    HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
    if [[ -n ${DRAGONGL_STATE_DIR:-} ]]; then
        STATE_DIR=$DRAGONGL_STATE_DIR
    elif [[ -x $HERE/build/dragongl_server || -f $HERE/CMakeLists.txt ]]; then
        STATE_DIR=$HERE/state
    elif [[ ${XDG_STATE_HOME:-} == /* ]]; then
        STATE_DIR=$XDG_STATE_HOME/dragongl
    elif [[ ${HOME:-} == /* ]]; then
        STATE_DIR=$HOME/.local/state/dragongl
    else
        die "no state directory: use --state-dir"
    fi
fi

if [[ ! -d $STATE_DIR ]]; then
    printf 'Nothing to reset: %s does not exist.\n' "$STATE_DIR"
    exit 0
fi
# Refuse anything that does not look like a Dragon GL state directory, so
# a wrong --state-dir can never delete unrelated files.
[[ -d $STATE_DIR/saves ]] || die "$STATE_DIR is not a Dragon GL state directory (no saves/)"

# The running server holds an flock on server.lock: resetting under it
# would be undone by its next autosave.
if [[ -f $STATE_DIR/server.lock ]] && command -v flock >/dev/null 2>&1; then
    flock -n "$STATE_DIR/server.lock" true ||
        die "a dragongl_server is running on $STATE_DIR: stop it first"
fi

printf 'This deletes the world, the NPCs, every character and tombstone, the logs\n'
printf 'and the DM maps in:\n  %s\n' "$STATE_DIR"
if ((!ASSUME_YES)); then
    read -r -p "Continue? (y/N) " answer
    [[ $answer =~ ^([yY]|[yY][eE][sS])$ ]] || { printf 'Cancelled.\n'; exit 0; }
fi

rm -f -- "$STATE_DIR"/world.dat "$STATE_DIR"/npcs.dat "$STATE_DIR"/artifacts.dat \
         "$STATE_DIR"/combat_log.json "$STATE_DIR"/combat_log.json.1 "$STATE_DIR"/*.tmp
rm -f -- "$STATE_DIR"/saves/*.save "$STATE_DIR"/saves/tombstone_*.dat "$STATE_DIR"/saves/*.tmp
rm -f -- "$STATE_DIR"/maps/*.txt "$STATE_DIR"/maps/*.pdf

printf 'World reset. The next server start generates a new world.\n'
